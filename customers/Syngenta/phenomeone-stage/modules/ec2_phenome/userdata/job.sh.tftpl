#!/bin/bash
set -e

dnf update -y
dnf install -y docker jq unzip zip socat cronie
systemctl enable crond
systemctl start crond

DOCKER_COMPOSE_VERSION="2.24.0"
curl -L "https://github.com/docker/compose/releases/download/v$DOCKER_COMPOSE_VERSION/docker-compose-$(uname -s)-$(uname -m)" -o /usr/local/bin/docker-compose
chmod +x /usr/local/bin/docker-compose
ln -sf /usr/local/bin/docker-compose /usr/bin/docker-compose

systemctl enable docker
systemctl start docker

# Syngenta Root CA (needed for MINT integration TLS - mint.cloud.syngenta.org)
mkdir -p /opt/unity-job/config/certs
cat > /opt/unity-job/config/certs/SyngentaRootCA.crt <<'EOF_SYNGENTA_CA'
-----BEGIN CERTIFICATE-----
MIIFlzCCA3+gAwIBAgIQTp3URxWoUoJKs0zsWq3NJzANBgkqhkiG9w0BAQUFADBe
MRMwEQYKCZImiZPyLGQBGRYDT1JHMRgwFgYKCZImiZPyLGQBGRYIU1lOR0VOVEEx
FDASBgoJkiaJk/IsZAEZFgRFQU1FMRcwFQYDVQQDEw5TeW5nZW50YVJvb3RDQTAe
Fw0xMDA5MDMxODA1NTFaFw0zNTA5MDMxODEyNDhaMF4xEzARBgoJkiaJk/IsZAEZ
FgNPUkcxGDAWBgoJkiaJk/IsZAEZFghTWU5HRU5UQTEUMBIGCgmSJomT8ixkARkW
BEVBTUUxFzAVBgNVBAMTDlN5bmdlbnRhUm9vdENBMIICIjANBgkqhkiG9w0BAQEF
AAOCAg8AMIICCgKCAgEAo80FMlSka74wWk3zmw9/Rxre5samuap2kRSORiXF0Rhk
EjYTQl5XIUWbuTlmLcb/16Rjt0lo8YpsaON74l1+88dPLi9038yPRCxL5o0ElOp+
KEKZDsnGspig4vWeLlu95T8O6rxi+UvYL81upnvwivfYXnMxo24rS3/rky8fOfrx
cP6cgNhL8Ys18hv/k9IxCoxX0Vxq35LklG69VyGLfKR2uaH5fWGsO+HZ1pF5zIZ+
VU9dE60EkF4m0nbHrHsaPMlnhimdxfyydNdMIWKlVxtBWvQjm2BTcLEzIkHXcH7g
gigFbbjZanfhll2Mj4jZ9gY7xCjHYl+MsrVSU+sgYbL0GWEJs4ht/cqj9kY3qPBs
yLK32iRosOyZ3u1+hxj8Q8/OXFW1Lhik9wLldZUhHGMyYK/kVTk3DHMB/5GRkCuh
RPoigFTZqAmYXMyvbTu7bCOrIOqdMToCWvxc+BHsfNv4Q/HFUMLihr4NLAmxLuHO
4YOvuksCZ4VsZU73Zt/u1I2mvDOGNH2y2+KS5ybj4dIoVcavu+3TE3NyQUm6G0P+
woCLgaL+AA19K7lTbpBwvxTnHFH0onifXLIgjWJK84cEb2PFNIm208NhvHh8WUrL
FUGDTRIoDvb9Cl9erey4bADytXE9HxQZervK+UZLI8o7Xi83VXFse/6jC6nXWdEC
AwEAAaNRME8wCwYDVR0PBAQDAgGGMA8GA1UdEwEB/wQFMAMBAf8wHQYDVR0OBBYE
FMewsdfkHpEcUup3GISP4tJoJf+HMBAGCSsGAQQBgjcVAQQDAgEAMA0GCSqGSIb3
DQEBBQUAA4ICAQAvuoC29eAxQ5otqNhsZoy8uxIqbM/gaRI9uQsW4F4D/jCVkYGt
