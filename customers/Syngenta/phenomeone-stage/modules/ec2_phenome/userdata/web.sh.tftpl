EOF_SYNGENTA_CA
cp /opt/unity-web/config/certs/SyngentaRootCA.crt /etc/pki/ca-trust/source/anchors/SyngentaRootCA.crt
update-ca-trust extract
cp /etc/pki/tls/certs/ca-bundle.crt /opt/unity-web/config/certs/ca-bundle.crt

APP_REGION="${region}"

# Fetch credentials from Secrets Manager
SECRET_JSON=$(aws secretsmanager get-secret-value --secret-id "${web_secret_name}" --region "$APP_REGION" --query SecretString --output text)
DB_PASSWORD=$(echo "$SECRET_JSON" | jq -r '.db_password')

aws ecr get-login-password --region us-east-1 | docker login --username AWS --password-stdin 590183981388.dkr.ecr.us-east-1.amazonaws.com

mkdir -p /opt/unity-web/config/web

cat > /opt/unity-web/config/web/webapp.conf <<EOF_WEBCONF
name WebApp
environment prod
reset_password_valid_hours 5
work_dir /tmp/web_server
storage_handler S3
queue_handler SQS
cookie_Secure true
cookie_SameSite Lax
revision ${revision}
changelog 1097
email_sender support@phenome-networks.com
region $APP_REGION
phenome_server_url http://127.0.0.1

<Model::PHN2>
    <connect_info>
        dsn               dbi:mysql:database=${db_name};host=${db_endpoint};port=${db_port}
        user              ${db_user}
        password          $DB_PASSWORD
        quote_names       1
        mysql_enable_utf8 1
        mysql_local_infile 1
    </connect_info>
</Model::PHN2>

<S3>
    auth_method V4
    region $APP_REGION
</S3>

<Storage tiledb>
    bucket_name ${tiledb_bucket_name}
    ws_root https://s3.$APP_REGION.amazonaws.com
    work_dir /tmp/web_server/genomics
    region $APP_REGION
</Storage>

<Storage uploads>
    bucket_name ${uploads_bucket_name}
    ws_root https://s3.$APP_REGION.amazonaws.com
    work_dir /tmp/job_server/uploads
    region $APP_REGION
</Storage>

<Storage images>
    bucket_name ${images_bucket_name}
    ws_root https://s3.$APP_REGION.amazonaws.com
    work_dir /tmp/job_server/images
    region $APP_REGION
</Storage>

<Storage analyses>
    bucket_name ${analyses_bucket_name}
    ws_root https://s3.$APP_REGION.amazonaws.com
    work_dir /tmp/job_server/analyses
    region $APP_REGION
</Storage>

<Storage reports>
    bucket_name ${images_bucket_name}
    ws_root https://s3.$APP_REGION.amazonaws.com
    work_dir /tmp/job_server/reports
    region $APP_REGION
</Storage>

<Storage documents>
    bucket_name ${documents_bucket_name}
    ws_root https://s3.$APP_REGION.amazonaws.com
    work_dir /tmp/job_server/documents
    region $APP_REGION
</Storage>

<SQS>
    region $APP_REGION
</SQS>

<Queue other>
    queue_name arn:aws:sqs:$APP_REGION:590183981388:${sqs_queue_name}
</Queue>

<Queue assoc>
    queue_name arn:aws:sqs:$APP_REGION:590183981388:${sqs_queue_name}
</Queue>

<Queue analysis>
    queue_name arn:aws:sqs:$APP_REGION:590183981388:${sqs_queue_name}
</Queue>

<SNS MintMaterial>
    topic   ${sns_mint_material_arn}
    region  us-east-1
</SNS>

<SNS MintIdentity>
    topic   ${sns_mint_integration_arn}
    region  us-east-1
</SNS>
EOF_WEBCONF

cat > /opt/unity-web/config/web/webapp_log.conf <<EOF_LOGCONF
log4perl.logger = DEBUG, Screen, Logfile
log4perl.appender.Screen = Log::Log4perl::Appender::Screen
log4perl.appender.Screen.stderr = 0
log4perl.appender.Screen.layout = Log::Log4perl::Layout::PatternLayout
log4perl.appender.Screen.layout.ConversionPattern = %p %P %C::%M-%L %d - %m%n
log4perl.appender.Logfile = Log::Log4perl::Appender::File
log4perl.appender.Logfile.filename = /var/log/webapp.log
log4perl.appender.Logfile.layout = Log::Log4perl::Layout::PatternLayout
log4perl.appender.Logfile.layout.ConversionPattern = %d %p %C::%M-%L , %m%n
EOF_LOGCONF

cat > /opt/unity-web/config/web/webapp.json <<EOF_WEBJSON
{
  "name": "WebApp",
  "environment": "prod",
  "reset_password_valid_hours": 5,
  "work_dir": "/tmp/web_server",
  "storage_handler": "S3",
  "queue_handler": "SQS",
  "cookie_Secure": true,
  "cookie_SameSite": "Lax",
  "revision": ${revision},
  "changelog": 1097,
  "email_sender": "support@phenome-networks.com",
  "region": "$APP_REGION",
  "phenome_server_url": "http://127.0.0.1",
  "Model::PHN2": {
    "connect_info": {
      "dsn": "dbi:mysql:database=${db_name};host=${db_endpoint};port=${db_port}",
      "user": "${db_user}",
      "password": "$DB_PASSWORD",
      "quote_names": 1,
      "mysql_enable_utf8": 1,
      "mysql_local_infile": 1
    }
  },
  "S3": {
    "auth_method": "V4",
    "region": "$APP_REGION"
  },
  "SQS": {
    "region": "$APP_REGION"
  },
  "Storage": {
    "tiledb": {
      "bucket_name": "${tiledb_bucket_name}",
      "ws_root": "https://s3.$APP_REGION.amazonaws.com",
      "work_dir": "/tmp/web_server/genomics",
      "region": "$APP_REGION"
    },
    "uploads": {
      "bucket_name": "${uploads_bucket_name}",
      "ws_root": "https://s3.$APP_REGION.amazonaws.com",
      "work_dir": "/tmp/job_server/uploads",
      "region": "$APP_REGION"
    },
    "images": {
      "bucket_name": "${images_bucket_name}",
      "ws_root": "https://s3.$APP_REGION.amazonaws.com",
      "work_dir": "/tmp/job_server/images",
      "region": "$APP_REGION"
    },
    "analyses": {
      "bucket_name": "${analyses_bucket_name}",
      "ws_root": "https://s3.$APP_REGION.amazonaws.com",
      "work_dir": "/tmp/job_server/analyses",
      "region": "$APP_REGION"
    },
    "reports": {
      "bucket_name": "${images_bucket_name}",
      "ws_root": "https://s3.$APP_REGION.amazonaws.com",
      "work_dir": "/tmp/job_server/reports",
      "region": "$APP_REGION"
    },
    "documents": {
      "bucket_name": "${documents_bucket_name}",
      "ws_root": "https://s3.$APP_REGION.amazonaws.com",
      "work_dir": "/tmp/job_server/documents",
      "region": "$APP_REGION"
    }
  },
  "SNS": {
    "MintMaterial": {
      "topic": "${sns_mint_material_arn}",
      "region": "us-east-1"
    },
    "MintIdentity": {
      "topic": "${sns_mint_integration_arn}",
      "region": "us-east-1"
    }
  }
}
EOF_WEBJSON

cat > /opt/unity-web/docker-compose.yml <<EOF_COMPOSE
version: '3.8'

services:
  python:
    image: 590183981388.dkr.ecr.us-east-1.amazonaws.com/phenomeone-dev-phn-flask-ecr:${revision}
    container_name: python
    restart: unless-stopped
    ports:
      - "5001:5001"
    environment:
      - SSL_CERT_FILE=/etc/ssl/certs/ca-bundle.crt
      - REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-bundle.crt
    volumes:
      - ./config/certs/ca-bundle.crt:/etc/ssl/certs/ca-bundle.crt:ro
      - ./config/web/webapp.conf:/srv/vhosts/unity/webapp.conf:ro
      - ./config/web/webapp.conf:/opt/phn/unity/WebApp/webapp.conf:ro
      - ./config/web/webapp_log.conf:/srv/vhosts/unity/webapp_log.conf:ro
      - ./config/web/webapp_log.conf:/opt/phn/unity/WebApp/webapp_log.conf:ro
      - ./config/web/webapp.json:/opt/phn/unity.R${revision}/WebApp/lib/PHN/Python/webapp_conf.json:ro
    networks:
      - unity-net

  web:
    image: 590183981388.dkr.ecr.us-east-1.amazonaws.com/phenomeone-dev-phn-web-ecr:${revision}
    container_name: web
    restart: unless-stopped
    ports:
      - "80:80"
    environment:
      - SSL_CERT_FILE=/etc/ssl/certs/ca-bundle.crt
      - HTTPS_CA_FILE=/etc/ssl/certs/ca-bundle.crt
      - PERL_LWP_SSL_CA_FILE=/etc/ssl/certs/ca-bundle.crt
      - PERL5LIB=/opt/phn/unity.R${revision}/WebApp/lib:/srv/vhosts/unity/lib
    volumes:
      - ./config/certs/ca-bundle.crt:/etc/ssl/certs/ca-bundle.crt:ro
      - ./config/web/webapp.conf:/srv/vhosts/unity/webapp.conf:ro
      - ./config/web/webapp.conf:/opt/phn/unity.R${revision}/WebApp/webapp.conf:ro
      - ./config/web/webapp_log.conf:/srv/vhosts/unity/webapp_log.conf:ro
      - ./config/web/webapp_log.conf:/opt/phn/unity.R${revision}/WebApp/webapp_log.conf:ro
    command: sh -c 'socat TCP-LISTEN:5001,fork TCP:python:5001 & plackup -I /srv/vhosts/unity/lib -I /opt/phn/unity.R${revision}/WebApp/lib -s Starman --host 0.0.0.0 --workers ${web_workers} --port 80 /srv/vhosts/unity/script/webapp_plack.plk'
    depends_on:
      - python
    networks:
      - unity-net

networks:
  unity-net:
    driver: bridge
EOF_COMPOSE

cd /opt/unity-web
docker-compose up -d

# Save current revision
echo "${revision}" > /opt/unity-web/.current_revision

# Write update_revision script
cat > /opt/unity-web/update_revision.sh <<'ENDSCRIPT'
#!/bin/bash
set -euo pipefail

MODE="$${1:-}"
if [ "$MODE" != "web" ] && [ "$MODE" != "job" ]; then
  echo "Usage: $0 <web|job>"
  exit 1
fi

REGION="${region}"
SSM_PARAM_NAME="${ssm_param_path}"
ACCOUNT_ID="590183981388"
ECR_REGISTRY="$ACCOUNT_ID.dkr.ecr.us-east-1.amazonaws.com"

if [ "$MODE" = "web" ]; then
  COMPOSE_DIR="/opt/unity-web"
else
  COMPOSE_DIR="/opt/unity-job"
fi

REVISION_FILE="$COMPOSE_DIR/.current_revision"
LOG="/var/log/update_revision_$${MODE}.log"

log() { echo "$(date '+%Y-%m-%d %H:%M:%S') [$MODE] $*" >> "$LOG"; }

NEW_REVISION=$(aws ssm get-parameter --name "$SSM_PARAM_NAME" --region "$REGION" --query 'Parameter.Value' --output text 2>>"$LOG") || {
  log "ERROR: failed to read SSM parameter"
  exit 1
}

CURRENT_REVISION=""
if [ -f "$REVISION_FILE" ]; then
  CURRENT_REVISION=$(cat "$REVISION_FILE")
fi

if [ "$NEW_REVISION" = "$CURRENT_REVISION" ]; then
  exit 0
fi

log "Revision changed: $CURRENT_REVISION -> $NEW_REVISION. Redeploying..."

aws ecr get-login-password --region us-east-1 | docker login --username AWS --password-stdin "$ECR_REGISTRY" >> "$LOG" 2>&1

SECRET_JSON=$(aws secretsmanager get-secret-value --secret-id "${web_secret_name}" --region "$REGION" --query SecretString --output text)
DB_PASSWORD=$(echo "$SECRET_JSON" | jq -r '.db_password')

DB_NAME="${db_name}"
DB_ENDPOINT="${db_endpoint}"
DB_PORT="${db_port}"
DB_USER="${db_user}"
SQS_QUEUE="${sqs_queue_name}"
QUEUE_ARN="arn:aws:sqs:$REGION:$ACCOUNT_ID:$SQS_QUEUE"

TILEDB_BUCKET="${tiledb_bucket_name}"
UPLOADS_BUCKET="${uploads_bucket_name}"
IMAGES_BUCKET="${images_bucket_name}"
ANALYSES_BUCKET="${analyses_bucket_name}"
REPORTS_BUCKET="${reports_bucket_name}"
DOCUMENTS_BUCKET="${documents_bucket_name}"
WEB_WORKERS=${web_workers}

cat > "$COMPOSE_DIR/config/web/webapp.conf" <<CONF
name WebApp
environment prod
reset_password_valid_hours 5
work_dir /tmp/web_server
storage_handler S3
queue_handler SQS
cookie_Secure true
cookie_SameSite Lax
revision $NEW_REVISION
changelog 1097
email_sender support@phenome-networks.com
region $REGION
phenome_server_url http://127.0.0.1

<Model::PHN2>
    <connect_info>
        dsn               dbi:mysql:database=$DB_NAME;host=$DB_ENDPOINT;port=$DB_PORT
        user              $DB_USER
        password          $DB_PASSWORD
        quote_names       1
        mysql_enable_utf8 1
        mysql_local_infile 1
    </connect_info>
</Model::PHN2>

<S3>
    auth_method V4
    region $REGION
</S3>

<Storage tiledb>
    bucket_name $TILEDB_BUCKET
    ws_root https://s3.$REGION.amazonaws.com
    work_dir /tmp/web_server/genomics
    region $REGION
</Storage>

<Storage uploads>
    bucket_name $UPLOADS_BUCKET
    ws_root https://s3.$REGION.amazonaws.com
    work_dir /tmp/job_server/uploads
    region $REGION
</Storage>

<Storage images>
    bucket_name $IMAGES_BUCKET
    ws_root https://s3.$REGION.amazonaws.com
    work_dir /tmp/job_server/images
    region $REGION
</Storage>

<Storage analyses>
    bucket_name $ANALYSES_BUCKET
    ws_root https://s3.$REGION.amazonaws.com
    work_dir /tmp/job_server/analyses
    region $REGION
</Storage>

<Storage reports>
    bucket_name $IMAGES_BUCKET
    ws_root https://s3.$REGION.amazonaws.com
    work_dir /tmp/job_server/reports
    region $REGION
</Storage>

<Storage documents>
    bucket_name $DOCUMENTS_BUCKET
    ws_root https://s3.$REGION.amazonaws.com
    work_dir /tmp/job_server/documents
    region $REGION
</Storage>

<SQS>
    region $REGION
</SQS>

<Queue other>
    queue_name $QUEUE_ARN
</Queue>

<Queue assoc>
    queue_name $QUEUE_ARN
</Queue>

<Queue analysis>
    queue_name $QUEUE_ARN
</Queue>

<SNS MintMaterial>
    topic   ${sns_mint_material_arn}
    region  us-east-1
</SNS>

<SNS MintIdentity>
    topic   ${sns_mint_integration_arn}
    region  us-east-1
</SNS>
CONF

