#!/bin/bash
set -e

dnf update -y
dnf install -y docker jq unzip zip socat cronie
systemctl enable crond
systemctl start crond

DOCKER_COMPOSE_VERSION="2.24.0"
curl -L "https://github.com/docker/compose/releases/download/v$DOCKER_COMPOSE_VERSION/docker-compose-$(uname -s)-$(uname -m)" -o /usr/local/bin/docker-compose
chmod +x /usr/local/bin/docker-compose
ln -sf /usr/local/bin/docker-compose /usr/bin/docker-compose

systemctl enable docker
systemctl start docker

# Syngenta Root CA (needed for MINT integration TLS - mint.cloud.syngenta.org)
mkdir -p /opt/unity-web/config/certs
cat > /opt/unity-web/config/certs/SyngentaRootCA.crt <<'EOF_SYNGENTA_CA'
-----BEGIN CERTIFICATE-----
