cat > "$COMPOSE_DIR/docker-compose.yml" <<COMPOSE
version: '3.8'

services:
  python:
    image: $ECR_REGISTRY/phenomeone-dev-phn-flask-ecr:$NEW_REVISION
    container_name: python
    restart: unless-stopped
    ports:
      - "5001:5001"
    environment:
      - SSL_CERT_FILE=/etc/ssl/certs/ca-bundle.crt
      - REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-bundle.crt
    volumes:
      - ./config/certs/ca-bundle.crt:/etc/ssl/certs/ca-bundle.crt:ro
      - ./config/web/webapp.conf:/srv/vhosts/unity/webapp.conf:ro
      - ./config/web/webapp.conf:/opt/phn/unity/WebApp/webapp.conf:ro
      - ./config/web/webapp_log.conf:/srv/vhosts/unity/webapp_log.conf:ro
      - ./config/web/webapp_log.conf:/opt/phn/unity/WebApp/webapp_log.conf:ro
      - ./config/web/webapp.json:/opt/phn/unity.R$NEW_REVISION/WebApp/lib/PHN/Python/webapp_conf.json:ro
    networks:
      - unity-net

  web:
    image: $ECR_REGISTRY/phenomeone-dev-phn-web-ecr:$NEW_REVISION
    container_name: web
    restart: unless-stopped
    ports:
      - "80:80"
    environment:
      - SSL_CERT_FILE=/etc/ssl/certs/ca-bundle.crt
      - HTTPS_CA_FILE=/etc/ssl/certs/ca-bundle.crt
      - PERL_LWP_SSL_CA_FILE=/etc/ssl/certs/ca-bundle.crt
      - PERL5LIB=/opt/phn/unity.R$${NEW_REVISION}/WebApp/lib:/srv/vhosts/unity/lib
    volumes:
      - ./config/certs/ca-bundle.crt:/etc/ssl/certs/ca-bundle.crt:ro
      - ./config/web/webapp.conf:/srv/vhosts/unity/webapp.conf:ro
      - ./config/web/webapp.conf:/opt/phn/unity.R$${NEW_REVISION}/WebApp/webapp.conf:ro
      - ./config/web/webapp_log.conf:/srv/vhosts/unity/webapp_log.conf:ro
      - ./config/web/webapp_log.conf:/opt/phn/unity.R$${NEW_REVISION}/WebApp/webapp_log.conf:ro
    command: sh -c 'socat TCP-LISTEN:5001,fork TCP:python:5001 & plackup -I /srv/vhosts/unity/lib -I /opt/phn/unity.R$${NEW_REVISION}/WebApp/lib -s Starman --host 0.0.0.0 --workers $WEB_WORKERS --port 80 /srv/vhosts/unity/script/webapp_plack.plk'
    depends_on:
      - python
    networks:
      - unity-net

networks:
  unity-net:
    driver: bridge
COMPOSE

cd "$COMPOSE_DIR"
docker-compose pull >> "$LOG" 2>&1
docker-compose down >> "$LOG" 2>&1
docker-compose up -d >> "$LOG" 2>&1

echo "$NEW_REVISION" > "$REVISION_FILE"
log "Successfully deployed revision $NEW_REVISION"
ENDSCRIPT

chmod +x /opt/unity-web/update_revision.sh

# Set up cron to check for revision updates every minute
echo "* * * * * /opt/unity-web/update_revision.sh web" | crontab -

${elastic_agent}
